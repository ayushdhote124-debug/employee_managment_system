{
  "name": "employee-attendance-management-system",
  "version": "1.0.0",
  "description": "Employee Attendance Management System using MERN stack",
  "scripts": {
    "install-all": "npm install && npm install --prefix client && npm install --prefix server",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "build": "node -e \"const fs=require('fs'),{execSync}=require('child_process');if(fs.existsSync('client')){execSync('npm run build',{cwd:'client',stdio:'inherit'})}else{execSync('npm run build',{stdio:'inherit'})}\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
